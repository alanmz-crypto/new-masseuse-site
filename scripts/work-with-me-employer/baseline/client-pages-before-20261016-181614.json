->\n\n<!-- wp:uagb\/advanced-heading {\"block_id\":\"a1e2f3a2\",\"classMigrate\":true,\"headingDescToggle\":false,\"headingColor\":\"var(--ast-global-color-0)\",\"blockLeftPadding\":28,\"blockBottomPadding\":100,\"blockTopPaddingTablet\":0,\"blockRightPaddingTablet\":0,\"blockLeftPaddingTablet\":0,\"blockBottomPaddingTablet\":0,\"blockTopPaddingMobile\":8,\"blockRightPaddingMobile\":0,\"blockLeftPaddingMobile\":0,\"blockBottomPaddingMobile\":0} -->\n<div class=\"wp-block-uagb-advanced-heading uagb-block-a1e2f3a2\"><\/div>\n<!-- \/wp:uagb\/advanced-heading -->\n\n<!-- wp:uagb\/advanced-heading {\"block_id\":\"b2f3a2b3\",\"classMigrate\":true,\"headingDescToggle\":true,\"subHeadingColor\":\"\",\"headSpace\":8,\"subHeadSpace\":0} -->\n<div class=\"wp-block-uagb-advanced-heading uagb-block-b2f3a2b3\"><h2 class=\"uagb-heading-text\">Common Reasons Clients Choose Therapeutic Massage<\/h2><p class=\"uagb-desc-text\">People often book therapeutic massage for everyday tension and stiffness, or simply for time to slow down. Before I begin, I ask about your preferences and anything I should know about your health. During the session you can ask for lighter pressure, a different focus, or a pause at any time.<\/p><\/div>\n<!-- \/wp:uagb\/advanced-heading --><\/div>\n<!-- \/wp:uagb\/container -->\n\n<!-- wp:uagb\/container {\"block_id\":\"c3a2b3c4\",\"bottomPaddingDesktop\":40,\"topPaddingTablet\":0,\"bottomPaddingTablet\":40,\"leftPaddingTablet\":0,\"rightPaddingTablet\":0,\"topPaddingMobile\":0,\"bottomPaddingMobile\":30,\"leftPaddingMobile\":0,\"rightPaddingMobile\":0,\"paddingLink\":false,\"rowGapMobile\":12,\"columnGapDesktop\":32,\"columnGapTablet\":20,\"containerBorderTopWidth\":0,\"containerBorderLeftWidth\":0,\"containerBorderRightWidth\":0,\"containerBorderBottomWidth\":1,\"containerBorderLink\":false,\"containerBorderStyle\":\"solid\",\"containerBorderColor\":\"var(--ast-global-color-6)\",\"layout\":\"grid\",\"gridColumnDesktop\":[{\"default\":\"custom\",\"min\":{\"un