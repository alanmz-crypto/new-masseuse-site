owBlur\":5,\"imageBoxShadowSpread\":-1,\"customHeightSetDesktop\":true,\"customHeightSetTablet\":true,\"customHeightSetMobile\":true,\"imageBorderTopLeftRadius\":20,\"imageBorderTopRightRadius\":20,\"imageBorderBottomLeftRadius\":20,\"imageBorderBottomRightRadius\":20,\"imageBorderTopLeftRadiusTablet\":16,\"imageBorderTopRightRadiusTablet\":16,\"imageBorderBottomLeftRadiusTablet\":16,\"imageBorderBottomRightRadiusTablet\":16,\"imageBorderTopLeftRadiusMobile\":14,\"imageBorderTopRightRadiusMobile\":14,\"imageBorderBottomLeftRadiusMobile\":14,\"imageBorderBottomRightRadiusMobile\":14} -->\n<div class=\"wp-block-uagb-image uagb-block-d4b3c4d5 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none\"><figure class=\"wp-block-uagb-image__figure\"><img srcset=\"http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/hOh0PE6VA0DWpjjwFw494_611cce3c4199426298fab709c9a5d895.webp ,http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/hOh0PE6VA0DWpjjwFw494_611cce3c4199426298fab709c9a5d895.webp 780w, http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/hOh0PE6VA0DWpjjwFw494_611cce3c4199426298fab709c9a5d895.webp 360w\" sizes=\"(max-width: 480px) 150px\" src=\"http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/hOh0PE6VA0DWpjjwFw494_611cce3c4199426298fab709c9a5d895.webp\" alt=\"Illustration of a massage therapist working on a client lying face down.\" class=\"uag-image-1116\" width=\"200\" height=\"200\" title=\"Therapeutic Massage by Butsaba\" role=\"img\"\/><\/figure><\/div>\n<!-- \/wp:uagb\/image -->\n\n<!-- wp:uagb\/advanced-heading {\"block_id\":\"e5c4d5e6\",\"classMigrate\":true,\"headingDescToggle\":false,\"headingColor\":\"var(--ast-global-color-0)\",\"blockLeftPadding\":28,\"blockBottomPadding\":100,\"blockTopPaddingTablet\":0,\"blockRightPaddingTablet\":0,\"blockLeftPaddingTablet\":0,\"blockBottomPaddingTablet\":0,\"blockTopPaddingMobile\":8,\"blockRightPaddingMobile\":0,\"blockLeftPaddingMobile\":0,\"blockBottomPaddingMobile\":0} -->\n<div class=\"wp-block-uagb-advanced-heading uagb-block-e5c4d5e6\"><\/div>\n<!-- \/wp:uagb\/advanced-heading -->\n\n<!-- wp:uagb\/advanced-heading {\"block_id\":\"f6d5e6f7\",\"classMigrate\":true,\"headingDescToggle\":true,\"subHeadingColor\":\"\",\"headSpace\":8,\"subHeadSpace\":0} -->\n<div class=\"wp-block-uagb-advanced-heading uagb-block-f6d5e6f7\"><h2 class=\"uagb-heading-text\">Who Can Benefit From Therapeutic Massage?<\/h2><p class=\"uagb-desc-text\">Therapeutic massage can be adapted to many goals, from a calm session to focused work on areas of tension. If you have an ongoing health condition or a new symptom, tell me at the start. I will keep the work within the scope of massage, and I will tell you if I think you should check with a doctor first.<\/p><\/div>\n<!-- \/wp:uagb\/advanced-heading --><\/div>\n<!-- \/wp:uagb\/container -->\n\n<!-- wp:uagb\/container {\"block_id\":\"a7e6f7a8\",\"bottomPaddingDesktop\":0,\"paddingLink\":false,\"rowGapMobile\":12,\"columnGapDesktop\":32,\"columnGapTablet\":20,\"containerBorderTopWidth\":0,\"containerBorderLeftWidth\":0,\"containerBorderRightWidth\":0,\"containerBorderBottomWidth\":0,\"containerBorderLink\":false,\"containerBorderStyle\":\"none\",\"layout\":\"grid\",\"gridColumnDesktop\":[{\"default\":\"custom\",\"min\":{\"unit\":\"px\",\"value\":10},\"max\":{\"unit\":\"fr\",\"value\":1},\"custom\":{\"unit\":\"%\",\"value\":40}},{\"default\":\"custom\",\"min\":{\"unit\":\"px\",\"value\":10},\"max\":{\"unit\":\"fr\",\"value\":1},\"custom\":{\"unit\":\"%\",\"value\":8}},{\"default\":\"custom\",\"min\":{\"unit\":\"px\",\"value\":10},\"max\":{\"unit\":\"fr\",\"value\":1},\"custom\":{\"unit\":\"fr\",\"value\":1}}],\"gridColumnTablet\":[{\"default\":\"custom\",\"min\":{\"unit\":\"px\",\"value\":10},\"max\":{\"unit\":\"fr\",\"value\":1},\"custom\":{\"unit\":\"%\",\"value\":40}},{\"default\":\"custom\",\"min\":{\"unit\":\"px\",\"value\":10},\"max\":{\"unit\":\"fr\",\"value\":1},\"custom\":{\"unit\":\"%\",\"value\":7}},{\"default\":\"custom\",\"min\":{\"unit\":\"px\",\"value\":10},\"max\":{\"unit\":\"fr\",\"value\":1},\"custom\":{\"unit\":\"fr\",\"value\":1}}],\"gridAlignItemsDesktop\":\"center\",\"gridAlignItemsTablet\":\"start\"} -->\n<div class=\"wp-block-uagb-container uagb-layout-grid uagb-block-a7e6f7a8\"><!-- wp:uagb\/image {\"block_id\":\"b8f7a8b9\",\"disableLazyLoad\":true,\"url\":\"http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/m0KN9hXmTHYQo2KXHhj4c_aa9c21bbb6df4fa79691af5de41f6f48-1.png\",\"urlTablet\":\"http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/m0KN9hXmTHYQo2KXHhj4c_aa9c21bbb6df4fa79691af5de41f6f48-1.png\",\"urlMobile\":\"http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/m0KN9hXmTHYQo2KXHhj4c_aa9c21bbb6df4fa79691af5de41f6f48-1.png\",\"alt\":\"Illustration of a massage therapist working on a client lying face down.\",\"id\":1117,\"linkDestination\":\"none\",\"title\":\"Therapeutic Massage by Butsaba\",\"width\":200,\"widthTablet\":282,\"widthMobile\":800,\"height\":200,\"heightTablet\":194,\"heightMobile\":250,\"naturalWidth\":500,\"naturalHeight\":340,\"sizeSlug\":\"custom\",\"sizeSlugTablet\":\"custom\",\"sizeSlugMobile\":\"custom\",\"objectFit\":\"cover\",\"objectFitTablet\":\"cover\",\"objectFitMobile\":\"cover\",\"imageBoxShadowVOffset\":2,\"imageBoxShadowBlur\":5,\"imageBoxShadowSpread\":-1,\"customHeightSetDesktop\":true,\"customHeightSetTablet\":true,\"customHeightSetMobile\":true,\"imageBorderTopLeftRadius\":20,\"imageBorderTopRightRadius\":20,\"imageBorderBottomLeftRadius\":20,\"imageBorderBottomRightRadius\":20,\"imageBorderTopLeftRadiusTablet\":16,\"imageBorderTopRightRadiusTablet\":16,\"imageBorderBottomLeftRadiusTablet\":16,\"imageBorderBottomRightRadiusTablet\":16} -->\n<div class=\"wp-block-uagb-image uagb-block-b8f7a8b9 wp-block-uagb-image--layout-default wp-block-uagb-image--effect-static wp-block-uagb-image--align-none\"><figure class=\"wp-block-uagb-image__figure\"><img srcset=\"http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/m0KN9hXmTHYQo2KXHhj4c_aa9c21bbb6df4fa79691af5de41f6f48-1.png ,http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/m0KN9hXmTHYQo2KXHhj4c_aa9c21bbb6df4fa79691af5de41f6f48-1.png 780w, http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/m0KN9hXmTHYQo2KXHhj4c_aa9c21bbb6df4fa79691af5de41f6f48-1.png 360w\" sizes=\"(max-width: 480px) 150px\" src=\"http:\/\/localhost:8090\/wp-content\/uploads\/2026\/06\/m0KN9hXmTHYQo2KXHhj4c_aa9c21bbb6df4fa79691af5de41f6f48-1.png\" alt=\"Illustration of a massage therapist working on a client lying face down.\" class=\"uag-image-1117\" width=\"200\" height=\"200\" title=\"Therapeutic Massage by Butsaba\" role=\"img\"\/><\/figure><\/div>\n<!-- \/wp:uagb\/image -->\n\n<!-- wp:uagb\/advanced-heading {\"block_id\":\"c9a8b9c0\",\"classMigrate\":true,\"headingDescToggle\":false,\"headingColor\":\"var(--ast-global-color-0)\",\"blockLeftPadding\":28,\"blockBottomPadding\":100,\"blockTopPaddingTablet\":0,\"blockRightPaddingTablet\":0,\"blockLeftPaddingTablet\":0,\"blockBottomPaddingTablet\":0,\"blockTopPaddingMobile\":8,\"blockRightPaddingMobile\":0,\"blockLeftPaddingMobile\":0,\"blockBottomPaddingMobile\":0} -->\n<div class=\"wp-block-uagb-advanced-heading uagb-block-c9a8b9c0\"><\/div>\n<!-- \/wp:uagb\/advanced-heading -->\n\n<!-- wp:uagb\/faq {\"block_id\":\"d0b9c0d1\",\"borderStyle\":\"\",\"borderWidth\":\"\",\"borderRadius\":\"\",\"borderColor\":\"\",\"overallBorderTopWidth\":1,\"overallBorderLeftWidth\":1,\"overallBorderRightWidth\":1,\"overallBorderBottomWidth\":1,\"overallBorderTopLeftRadius\":2,\"overallBorderTopRightRadius\":2,\"overallBorderBottomLeftRadius\":2,\"overallBorderBottomRightRadius\":2,\"overallBorderStyle\":\"solid\",\"overallBorderColor\":\"#D2D2D2\"} -->\n<div class=\"wp-block-uagb-faq uagb-faq__outer-wrap uagb-block-d0b9c0d1 uagb-faq-icon-row uagb-faq-layout-accordion uagb-faq-expand-first-true uagb-faq-inactive-other-true uagb-faq-equal-height\" data-faqtoggle=\"true\" role=\"tablist\"><!-- wp:uagb\/faq-child {\"block_id\":\"e1c0d1e2\",\"question\":\"What Is the Difference Between Therapeutic and Relaxation Massage?\",\"answer\":\"Relaxation massage prioritizes a calm experience. Therapeutic massage can give more attention to a particular area of tension while still adapting pressure and pace to your comfort.\",\"icon\":\"chevron-up\",\"iconActive\":\"chevron-down\"} \/-->\n\n<!-- wp:uagb\/faq-child {\"block_id\":\"f2d1e2f3\",\"question\":\"How Is a Therapeutic Session Planned?\",\"answer\":\"Start by telling me what you would like from the session. Before I begin, I talk through the areas of focus, pace, and pressure with you.\",\"icon\":\"chevron-up\",\"iconActive\":\"chevron-down\"} \/-->\n\n<!-- wp:uagb\/faq-child {\"block_id\":\"a3e2f3a4\",\"question\":\"Will I Feel the Results Right Away?\",\"answer\":\"People respond differently to massage, so I can\u2019t promise a particular result or timeline. I will ask how the session feels and adjust as I go.\",\"icon\":\"chevron-up\",\"iconActive\":\"chevron-down\"} \/-->\n\n<!-- wp:uagb\/faq-child {\"block_id\":\"b4f3a4b5\",\"question\":\"How Often Should I Come In for Therapeutic Massage?\",\"answer\":\"There is no schedule that suits everyone. You decide whether another session makes sense, and I am glad to talk through your goals with you first.\",\"icon\":\"chevron-up\",\"iconActive\":\"chevron-down\"} \/-->\n\n<!-- wp:uagb\/faq-child {\"block_id\":\"c5a4b5c6\",\"question\":\"Is Therapeutic Massage Appropriate If I Have No Specific Complaint?\",\"answer\":\"Yes. You don\u2019t need a particular area of concern to book. Tell me what kind of session would feel good, and I will plan around that.\",\"icon\":\"chevron-up\",\"iconActive\":\"chevron-down\"} \/-->\n\n<!-- wp:uagb\/faq-child {\"block_id\":\"d6b5c6d7\",\"question\":\"Is Massage Okay if I Get Tension Headaches?\",\"answer\":\"If headaches are part of why you are coming in, mention them at the start. I can work on neck and shoulder tension within the scope of massage. For new, severe, or worrying headaches, please see a doctor first.\",\"icon\":\"chevron-up\",\"iconActive\":\"chevron-down\"} \/--><\/div>\n<!-- \/wp:uagb\/faq --><\/div>\n<!-- \/wp:uagb\/container -->\n\n<!-- wp:uagb\/advanced-heading {\"block_id\":\"e7c6d7e8\",\"classMigrate\":true,\"headingDescToggle\":false,\"headingDescPosition\":\"above-heading\",\"headingAlign\":\"center\",\"separatorColor\":\"var(--ast-global-color-0)\",\"seperatorStyle\":\"solid\",\"seperatorPosition\":\"above-heading\",\"separatorWidth\":64,\"separatorWidthType\":\"px\",\"headSpace\":0,\"separatorSpace\":14,\"blockTopPadding\":100,\"blockRightPadding\":220,\"blockLeftPadding\":220,\"blockBottomPadding\":0,\"blockTopPaddingTablet\":80,\"blockRightPaddingTablet\":40,\"blockLeftPaddingTablet\":40,\"blockBottomPaddingTablet\":0,\"blockTopPaddingMobile\":60,\"blockRightPaddingMobile\":0,\"blockLeftPaddingMobile\":0,\"blockBottomPaddingMobile\":0} -->\n<div class=\"wp-block-uagb-advanced-heading uagb-block-e7c6d7e8\"><div class=\"uagb-separator\"><\/div><h2 class=\"uagb-heading-text\">What To Expect During Your Appointment<\/h2><\/div>\n<!-- \/wp:uagb\/advanced-heading --><\/div><\/div>\n<!-- \/wp:uagb\/container -->\n\n<!-- wp:paragraph -->\n<p>Before your session, tell me about any health conditions, medications, pregnancy, recent injury or surgery. I may adjust the work, or suggest you check with your clinician first. New numbness, weakness, unexplained swelling or radiating pain means you should see a doctor before massage.<\/p>\n<!-- \/wp:paragraph -->\n\n<p><!-- PROCESS CARDS SECTION --><\/p>\n\n<!-- wp:uagb\/container {\"block_id\":\"f8d7e8f9\",\"topPaddingDesktop\":0,\"bottomPaddingDesktop\":100,\"leftPaddingDesktop\":40,\"rightPaddingDesktop\":40,\"topPaddingTablet\":40,\"bottomPaddingTablet\":80,\"leftPaddingTablet\":32,\"rightPaddingTablet\":32,\"topPaddingMobile\":40,\"bottomPaddingMobile\":64,\"leftPaddingMobile\":24,\"rightPaddingMobile\":24,\"paddingLink\":false,\"variationSelected\":true,\"rowGapDesktop\":30,\"rowGapTablet\":20,\"rowGapMobile\":20,\"columnGapDesktop\":30,\"columnGapTablet\":20,\"isBlockRootParent\":true,\"layout\":\"grid\",\"gridColumnDesktop\":[{\"default\":\"custom\",\"min\":{\"unit\":\"px\",\"value\":10},\"max\":{\"unit\":\"fr\",\"value\":1},\"custom\":{\"unit\":\"fr\",\"value\":1}},{\"default\":\"custom\",\"min\":{\"unit\":\"px\",\"value\":10},\"max\":{\"unit\":\"fr\",\"value\":1},\"custom\":{\"unit\":\"fr\",\"value\":1}}],\"gridColumnTablet\":[{\"default\":\"custom\",\"min\":{\"unit\":\"px\",\"value\":10},\"max\":{\"unit\":\"fr\",\"value\":1},\"custom\":{\"unit\":\"fr\",\"value\":1}},{\"default\":\"custom\",\"min\":{\"unit\":\"px\",\"value\":10},\"max\":{\"unit\":\"fr\",\"value\":1},\"custom\":{\"unit\":\"fr\",\"value\":1}}]} -->\n<div class=\"wp-block-uagb-container uagb-layout-grid uagb-block-f8d7e8f9 alignfull uagb-is-root-container\"><div class=\"uagb-container-inner-blocks-wrap\"><!-- wp:uagb\/container {\"block_id\":\"a9e8f9a0\",\"justifyContentDesktop\":\"flex-start\",\"topPaddingDesktop\":40,\"bottomPaddingDesktop\":40,\"leftPaddingDesktop\":40,\"rightPaddingDesktop\":40,\"topPaddingTablet\":32,\"bottomPaddingTablet\":32,\"leftPaddingTablet\":32,\"rightPaddingTablet\":32,\"topPaddingMobile\":24,\"bottomPaddingMobile\":24,\"leftPaddingMobile\":24,\"rightPaddingMobile\":24,\"containerBorderTopWidth\":1,\"containerBorderLeftWidth\":1,\"containerBorderRightWidth\":1,\"containerBorderBottomWidth\":1,\"containerBorderTopLeftRadius\":20,\"containerBorderTopRightRadius\":20,\"containerBorderBottomLeftRadius\":20,\"containerBorderBottomRightRadius\":20,\"containerBorderTopLeftRadiusTablet\":16,\"containerBorderTopRightRadiusTablet\":16,\"containerBorderBottomLeftRadiusTablet\":16,\"containerBorderBottomRightRadiusTablet\":16,\"containerBorderTopLeftRadiusMobile\":14,\"containerBorderTopRightRadiusMobile\":14,\"containerBorderBottomLeftRadiusMobile\":14,\"containerBorderBottomRightRadiusMobile\":14,\"containerBorderStyle\":\"solid\",\"containerBorderColor\":\"var(--ast-global-color-6)\",\"isGridCssInParent\":true} -->\n<div class=\"wp-block-uagb-container uagb-block-a9e8f9a0\"><!-- wp:uagb\/advanced-heading {\"block_id\":\"b0f9a0b1\",\"classMigrate\":true,\"headingDescToggle\":true,\"headingColor\":\"var(--ast-global-color-2)\",\"subHeadingColor\":\"\",\"headingTag\":\"p\",\"headSpace\":10,\"subHeadSpace\":0,\"headFontSize\":24,\"headFontSizeTablet\":22,\"headFontSizeMobile\":20,\"headLineHeight\":1.3000000000000000444089209850062616169452667236328125} -->\n<div class=\"wp-block-uagb-advanced-heading uagb-block-b0f9a0b1\"><p class=\"uagb-heading-text\">Consultation and Assessment<\/p><p class=\"uagb-desc-text\">I begin with a short conversation about where you\u2019re holding tension, what\u2019s been bothering you, and how you would like to feel when the session ends.<\/p><\/div>\n<!-- \/wp:uagb\/advanced-heading --><\/div>\n<!-- \/wp:uagb\/container -->\n\n<!-- wp:uagb\/container {\"block_id\":\"c1a0b1c2\",\"justifyContentDesktop\":\"flex-start\",\"topPaddingDesktop\":40,\"bottomPaddingDesktop\":40,\"leftPaddingDesktop\":40,\"rightPaddingDesktop\":40,\"topPaddingTablet\":32,\"bottomPaddingTablet\":32,\"leftPaddingTablet\":32,\"rightPaddingTablet\":32,\"topPaddingMobile\":24,\"bottomPaddingMobile\":24,\"leftPaddingMobile\":24,\"rightPaddingMobile\":24,\"containerBorderTopWidth\":1,\"containerBorderLeftWidth\":1,\"containerBorderRightWidth\":1,\"containerBorderBottomWidth\":1,\"containerBorderTopLeftRadius\":20,\"containerBorderTopRightRadius\":20,\"containerBorderBottomLeftRadius\":20,\"containerBorderBottomRightRadius\":20,\"containerBorderTopLeftRadiusTablet\":16,\"containerBorderTopRightRadiusTablet\":16,\"containerBorderBottomLeftRadiusTablet\":16,\"containerBorderBottomRightRadiusTablet\":16,\"containerBorderTopLeftRadiusMobile\":14,\"containerBorderTopRightRadiusMobile\":14,\"containerBorderBottomLeftRadiusMobile\":14,\"containerBorderBottomRightRa